    "update:visual": "playwright test --project=visual --update-snapshots",
    "check:size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.10.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vite": "5.4.19"
  }
}
