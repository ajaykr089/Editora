{
  "name": "editora-reference-app",
  "private": true,
  "description": "Tallyhawk: a fictional expense and approvals product (marketing site and app) built with Editora UI, from the packages' source. A design reference, and the app CI tests every change against.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
