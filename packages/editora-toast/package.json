{
  "name": "@editora/toast",
  "version": "2.1.2",
  "description": "Toast notifications for any framework, with nothing to mount and no CSS to import: promise toasts, actions, progress, a stack that opens on hover, light and dark, keyboard access, and React content with <Toaster />.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.esm.js"
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "import": "./dist/lite.esm.js",
      "require": "./dist/lite.cjs.js",
      "default": "./dist/lite.esm.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.esm.js",
      "require": "./dist/react.cjs.js",
      "default": "./dist/react.esm.js"
    },
    "./toast.css": "./dist/toast.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.css",
    "dist/**/*.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "react ui library",
    "react component library",
    "saas ui components",
    "enterprise react components",
    "modern design system",
    "rich text editor react",
    "editora",
    "editora ui ecosystem",
    "toast",
    "notification",
    "ui",
    "ux",
    "typescript",
    "framework-agnostic",
    "accessibility",
    "promise",
    "queue",
    "plugin",
    "editor",
    "rich-text-editor"
  ],
  "author": "Ajay Kumar <ajaykr089@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajaykr089/Editora.git",
    "directory": "packages/editora-toast"
  },
  "bugs": {
    "url": "https://github.com/ajaykr089/Editora/issues"
  },
  "homepage": "https://editora-ecosystem.netlify.app/docs/toast",
  "style": "dist/toast.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.umd.config.ts && tsc --emitDeclarationOnly --outDir dist && cp src/toast.css dist/",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "vitest": "^1.0.0"
  },
  "gitHead": "7883627e823aa99dd5ecb66a5201116df972f88b",
  "peerDependencies": {
    "react": ">=16.8 <21",
    "react-dom": ">=16.8 <21"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
