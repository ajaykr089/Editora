{
  "name": "@editora/content-a11y",
  "version": "0.0.0",
  "description": "Accessibility checks for the content people write (alt text, headings, links, tables, lists, contrast), with fixes. Runs in any editor, on a server or in CI.",
  "author": "Ajay Kumar <ajaykr089@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajaykr089/Editora.git",
    "directory": "packages/content-a11y"
  },
  "homepage": "https://editora-ecosystem.netlify.app/",
  "bugs": {
    "url": "https://github.com/ajaykr089/Editora/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "content-a11y": "bin/content-a11y.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./editora": {
      "types": "./dist/editora.d.ts",
      "import": "./dist/editora.js",
      "require": "./dist/editora.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "jsdom": ">=20",
    "linkedom": ">=0.16"
  },
  "peerDependenciesMeta": {
    "jsdom": { "optional": true },
    "linkedom": { "optional": true }
  },
  "devDependencies": {
    "jsdom": "^22.1.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag22",
    "european-accessibility-act",
    "alt-text",
    "headings",
    "link-text",
    "contrast",
    "content",
    "cms",
    "linter",
    "ci",
    "rich-text-editor",
    "editora"
  ]
}
