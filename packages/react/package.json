{
  "name": "@editora/react",
  "version": "1.0.30",
  "description": "React rich text editor (WYSIWYG) with 30+ plugins, an accessible toolbar and TypeScript types. Free and open source, for React 16.8 and newer.",
  "author": "Ajay Kumar <ajaykr089@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajaykr089/Editora.git",
    "directory": "packages/react"
  },
  "homepage": "https://editora-ecosystem.netlify.app/",
  "bugs": {
    "url": "https://github.com/ajaykr089/Editora/issues"
  },
  "keywords": [
    "react",
    "react-editor",
    "react-rich-text-editor",
    "rich-text-editor",
    "wysiwyg",
    "react-wysiwyg",
    "wysiwyg-editor",
    "rich-text",
    "text-editor",
    "html-editor",
    "contenteditable",
    "accessible",
    "typescript",
    "tinymce-alternative",
    "quill-alternative",
    "editora"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.esm.js"
    }
  },
  "files": [
    "dist",
    "index.d.ts",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@editora/core": "^1.0.26",
    "@editora/plugins": "^1.1.0",
    "@editora/themes": "^1.0.20",
    "react": ">=16.8 <21",
    "react-dom": ">=16.8 <21"
  },
  "peerDependenciesMeta": {
    "@editora/plugins": {
      "optional": true
    },
    "@editora/themes": {
      "optional": true
    }
  },
  "dependencies": {
    "@editora/light-code-editor": "^1.0.19"
  },
  "devDependencies": {
    "@editora/core": "^1.0.26",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "7883627e823aa99dd5ecb66a5201116df972f88b"
}
