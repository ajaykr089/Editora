{
  "name": "@editora/ai-review",
  "version": "0.2.0",
  "description": "Review AI rewrites as accept/reject suggestions in any rich text editor: word-level diffs, streaming, Ollama and bring-your-own-key providers.",
  "author": "Ajay Kumar <ajaykr089@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajaykr089/Editora.git",
    "directory": "packages/ai-review"
  },
  "homepage": "https://editora-ecosystem.netlify.app/",
  "bugs": {
    "url": "https://github.com/ajaykr089/Editora/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js",
      "require": "./dist/anthropic.cjs"
    },
    "./editora": {
      "types": "./dist/editora.d.ts",
      "import": "./dist/editora.js",
      "require": "./dist/editora.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "jsdom": "^22.1.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "llm",
    "ai-writing",
    "suggestions",
    "track-changes",
    "redline",
    "diff",
    "accept-reject",
    "rich-text-editor",
    "contenteditable",
    "ollama",
    "openai",
    "claude",
    "editora"
  ]
}
