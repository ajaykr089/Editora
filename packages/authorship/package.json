{
  "name": "@editora/authorship",
  "version": "0.1.0",
  "description": "Authorship tracking and AI disclosure for rich text editors: see which text was typed, pasted (from Word, Google Docs or the web), AI-written (with the model) or added by a collaborator. Highlights, writing replay, annotated HTML export and a tamper-evident witness server.",
  "author": "Ajay Kumar <ajaykr089@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajaykr089/Editora.git",
    "directory": "packages/authorship"
  },
  "homepage": "https://editora-ecosystem.netlify.app/",
  "bugs": {
    "url": "https://github.com/ajaykr089/Editora/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./editora": {
      "types": "./dist/editora.d.ts",
      "import": "./dist/editora.js",
      "require": "./dist/editora.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "^22.1.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "authorship",
    "authorship-tracking",
    "provenance",
    "content-provenance",
    "text-provenance",
    "ai-disclosure",
    "ai-transparency",
    "ai-generated-content",
    "ai-labeling",
    "eu-ai-act",
    "writing-replay",
    "writing-process",
    "paste-detection",
    "academic-integrity",
    "edtech",
    "iptc",
    "rich-text-editor",
    "wysiwyg",
    "contenteditable",
    "react",
    "editora"
  ]
}
