{
  "name": "@editora/ui-sortable",
  "version": "0.2.0",
  "description": "Drag-and-drop for the web: the <ui-sortable> board and list component, or sortable behaviour for your own markup (createSortable and a React useSortable hook), with keyboard, touch, screen-reader announcements and lists that exchange items.",
  "homepage": "https://editora-ecosystem.netlify.app/docs/ui-react/interactive/sortable",
  "bugs": {
    "url": "https://github.com/ajaykr089/Editora/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ajaykr089/Editora.git",
    "directory": "packages/ui-sortable"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.esm.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./dist/react.esm.js",
      "require": "./dist/react.cjs.js",
      "default": "./dist/react.esm.js"
    },
    "./headless": {
      "types": "./types/headless.d.ts",
      "import": "./dist/headless.esm.js",
      "require": "./dist/headless.cjs.js",
      "default": "./dist/headless.esm.js"
    },
    "./headless/react": {
      "types": "./types/headless-react.d.ts",
      "import": "./dist/headless-react.esm.js",
      "require": "./dist/headless-react.cjs.js",
      "default": "./dist/headless-react.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist types",
    "prepare": "vite build"
  },
  "dependencies": {
    "@editora/ui-core": "^0.6.0"
  },
  "peerDependencies": {
    "react": ">=16.8 <21",
    "react-dom": ">=16.8 <21"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "jsdom": "^22.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "vitest": "^1.6.1"
  },
  "keywords": [
    "editora",
    "sortable",
    "drag-and-drop",
    "web-components",
    "kanban",
    "tree",
    "accessible-ui",
    "headless",
    "react-hook",
    "useSortable",
    "reorder",
    "dnd"
  ],
  "author": "Ajay Kumar <ajaykr089@gmail.com>",
  "license": "MIT",
  "sideEffects": [
    "./dist/index.*",
    "./dist/react.*",
    "./src/index.ts",
    "./src/react.tsx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "react": [
        "types/react.d.ts"
      ],
      "headless": [
        "types/headless.d.ts"
      ],
      "headless/react": [
        "types/headless-react.d.ts"
      ]
    }
  }
}
