{
  "name": "@editora/rich-text-convert",
  "version": "0.0.0",
  "description": "Convert rich text between Tiptap/ProseMirror JSON, Lexical, Slate/Plate, Portable Text, Editor.js, HTML and Markdown, with a report of anything that could not be carried over.",
  "author": "Ajay Kumar <ajaykr089@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajaykr089/Editora.git",
    "directory": "packages/rich-text-convert"
  },
  "homepage": "https://editora-ecosystem.netlify.app/",
  "bugs": {
    "url": "https://github.com/ajaykr089/Editora/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rich-text-convert": "bin/rich-text-convert.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "rich-text",
    "converter",
    "migration",
    "tiptap",
    "prosemirror",
    "lexical",
    "slate",
    "plate",
    "portable-text",
    "sanity",
    "editorjs",
    "html",
    "markdown",
    "editora"
  ]
}
