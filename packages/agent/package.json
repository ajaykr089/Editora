{
  "name": "@editora/agent",
  "version": "0.1.0",
  "description": "AI agent for rich text editors: let Ollama, OpenAI-compatible models, Claude or any MCP client (Claude Desktop, Claude Code, Cursor) read and edit a document, with every edit shown as a suggestion to accept or reject.",
  "author": "Ajay Kumar <ajaykr089@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajaykr089/Editora.git",
    "directory": "packages/agent"
  },
  "homepage": "https://editora-ecosystem.netlify.app/",
  "bugs": {
    "url": "https://github.com/ajaykr089/Editora/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "editora-mcp": "bin/editora-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./editora": {
      "types": "./dist/editora.d.ts",
      "import": "./dist/editora.js",
      "require": "./dist/editora.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js",
      "require": "./dist/anthropic.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "require": "./dist/mcp.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.0.0",
    "@editora/ai-review": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@editora/ai-review": "*",
    "jsdom": "^22.1.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agent",
    "llm-agent",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "tool-calling",
    "function-calling",
    "ai-editing",
    "ai-suggestions",
    "track-changes",
    "document-editing",
    "ollama",
    "openai",
    "claude",
    "rich-text-editor",
    "wysiwyg",
    "contenteditable",
    "editora"
  ]
}
